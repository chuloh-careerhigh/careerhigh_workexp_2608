{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "커리어하이 일경험 활동가이드",
  "colors": {
    "primary": "#3182F6",
    "light": "#4E8FF7",
    "dark": "#1B64DA"
  },
  "fonts": {
    "heading": {
      "family": "Pretendard",
      "source": "https://cdn.jsdelivr.net/npm/pretendard@1.3.9/dist/web/variable/woff2/PretendardVariable.woff2",
      "format": "woff2",
      "weight": 700
    },
    "body": {
      "family": "Pretendard",
      "source": "https://cdn.jsdelivr.net/npm/pretendard@1.3.9/dist/web/variable/woff2/PretendardVariable.woff2",
      "format": "woff2",
      "weight": 400
    },
    "family": "Pretendard",
    "source": "https://cdn.jsdelivr.net/npm/pretendard@1.3.9/dist/web/variable/woff2/PretendardVariable.woff2",
    "format": "woff2"
  },
  "contextual": {
    "options": [
      "copy",
      "assistant"
    ],
    "display": "header"
  },
  "interaction": {
    "drilldown": false
  },
  "favicon": "/favicon.svg",
  "navigation": {
    "global": {
      "anchors": [
        {
          "anchor": "제출하기",
          "icon": "arrow-up-from-bracket",
          "href": "/submit"
        }
      ]
    },
    "tabs": [
      {
        "tab": "팀활동비",
        "pages": [
          {
            "group": "활동비 사용 이해하기",
            "pages": [
              "team-activity/expenses/process",
              "team-activity/expenses/usage-principles"
            ]
          },
          {
            "group": "지출품의 제출하기",
            "pages": [
              "team-activity/expenses/shared-folder",
              "team-activity/expenses/create-request-sheet",
              "team-activity/expenses/write-request",
              "team-activity/expenses/expense-request"
            ]
          },
          {
            "group": "지출결과 제출하기",
            "pages": [
              "team-activity/expenses/write-expense-result",
              "team-activity/expenses/supporting-documents",
              "team-activity/expenses/expense-result"
            ]
          },
          {
            "group": "제출서류 검수 및 평가",
            "pages": [
              "team-activity/expenses/review-process",
              "team-activity/expenses/cross-check",
              "team-activity/expenses/deduction-criteria"
            ]
          }
        ]
      },
      {
        "tab": "프로젝트 안내",
        "pages": [
          {
            "group": "프로젝트별 일정",
            "pages": [
              "team-activity/projects/schedules/real-estate-finance",
              "team-activity/projects/schedules/pension",
              "team-activity/projects/schedules/ecm",
              "team-activity/projects/schedules/digital-service",
              "team-activity/projects/schedules/overseas-securities",
              "team-activity/projects/schedules/risk-management",
              "team-activity/projects/schedules/corporate-sales",
              "team-activity/projects/schedules/research",
              "team-activity/projects/schedules/dcm",
              "team-activity/projects/schedules/trust"
            ]
          },
          "team-activity/projects/submission"
        ]
      }
    ]
  },
  "navbar": {
    "links": [
      {
        "label": "문의하기",
        "href": "https://careerhigh.channel.io/home"
      }
    ]
  },
  "background": {
    "decoration": "gradient"
  }
}
